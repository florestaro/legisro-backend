{
  "name": "computador-escola",
  "productName": "Computador Escola",
  "version": "0.1.0",
  "description": "Computador simulado para aulas de informática, com professor virtual que funciona sem internet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64",
    "demo-web": "node scripts/gerar-demo-web.js",
    "teste:servidor": "node testes/servidor-sala.js",
    "teste:sala": "node testes/sala-20-alunos.js"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.56.0"
  },
  "overrides": {
    "simple-git": "^4.0.2"
  },
  "build": {
    "appId": "br.escola.computador",
    "productName": "Computador Escola",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "app/**",
      "package.json",
      "!node_modules/@node-llama-cpp/*-cuda/**",
      "!node_modules/@node-llama-cpp/*-cuda-ext/**",
      "!node_modules/@node-llama-cpp/*-vulkan/**",
      "!node_modules/@node-llama-cpp/*-arm64/**",
      "!node_modules/@node-llama-cpp/*-armv7l/**"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "extraFiles": [
      {
        "from": "modelos",
        "to": "modelos",
        "filter": [
          "LEIA-ME.txt",
          "*.gguf"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "publish": null
  }
}
